GEMINI_API_KEY=your_gemini_api_key
# Use a model available to your Gemini project and quota tier.
GEMINI_MODEL=gemini-3.8-flash

# Configure when PostgreSQL is available; remote URLs can be used as well.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/insighthub

RAG_TOP_K=5
# Provisional starting threshold; calibrate against your policy questions.
RAG_MIN_SIMILARITY=0.5

# Ingestion: batch API calls, conservatively paced by chunk count.
EMBEDDING_BATCH_SIZE=20
EMBEDDING_CHUNKS_PER_MINUTE=60
